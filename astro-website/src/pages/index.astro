const primaryLink = (paper: Publication) =>
  paper.arxiv ? `https://arxiv.org/abs/${paper.arxiv}` : paper.paper ?? paper.project;

const paperLinks = (paper: Publication) =>
  [
    paper.arxiv && { label: 'arXiv', href: `https://arxiv.org/abs/${paper.arxiv}` },
    paper.arxiv && { label: 'PDF', href: `https://arxiv.org/pdf/${paper.arxiv}` },
    paper.paper && { label: 'Paper', href: paper.paper },
    paper.code && { label: 'Code', href: paper.code },
    paper.project && { label: 'Project', href: paper.project },
  ].filter(Boolean) as { label: string; href: string }[];

const bibStopWords = new Set(['a', 'an', 'the', 'on', 'of', 'for', 'and', 'why', 'how', 'towards']);

const bibKey = (paper: Publication) => {
  const surname = paper.authors[0].name.split(' ').at(-1)!.toLowerCase();
  const word = paper.title
    .split(/[^A-Za-z]+/)
    .find((w) => w && !bibStopWords.has(w.toLowerCase()))!
    .toLowerCase();
  return `${surname}${paper.year}${word}`;
};

const toBibtex = (paper: Publication) => {
  const authors = paper.authors.map((a) => (a.name === 'et al.' ? 'others' : a.name)).join(' and ');
  const fields: [string, string][] = [
    ['title', `{${paper.title}}`],
    ['author', authors],
  ];
  if (paper.kind === 'conference') fields.push(['booktitle', paper.venueFull!]);
  if (paper.kind === 'journal') fields.push(['journal', paper.venueFull!]);
  if (paper.kind === 'preprint') fields.push(['journal', `arXiv preprint arXiv:${paper.arxiv}`]);
  fields.push(['year', String(paper.year)]);
  const type = paper.kind === 'conference' ? 'inproceedings' : 'article';
  const body = fields.map(([k, v]) => `  ${k.padEnd(9)} = {${v}}`).join(',\n');
  return `@${type}{${bibKey(paper)},\n${body}\n}`;
};

