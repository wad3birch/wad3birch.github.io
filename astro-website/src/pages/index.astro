const pubKeyFor = (name: string) => {
  const paper =
    publications.find((p) => p.title.toLowerCase().startsWith(name.toLowerCase())) ??
    publications.find((p) => name === 'TrustGen' && p.project?.includes('trustgen'));
  return paper && bibKey(paper);
};
