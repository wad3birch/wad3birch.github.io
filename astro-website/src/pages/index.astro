  .pub-venue-short {
    color: var(--gold-text);
    font-size: 0.68rem;
    font-weight: 600;
  }

  .pub-venue--preprint .pub-venue-short {
    color: var(--ink-3);
  }

  .pub-venue-full {
    color: var(--ink-3);
    font-style: italic;
  }

  .pub-note {
    color: var(--ink);
    font-style: italic;
  }

  .pub-note::before {
    content: '— ';
    color: var(--gold-text);
  }

  /* ===========================
     V. CURRICULUM VITAE
  =========================== */
  .cv {
    display: flex;
    flex-direction: column;
    gap: 1.9rem;
    max-width: 46rem;
  }

  .cv-block {
    scroll-margin-top: 4rem;
  }

  .cv-label {
    margin-bottom: 0.7rem;
    color: var(--gold-text);
    font-size: 0.68rem;
  }

  .cv-entries {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .cv-line {
    display: flex;
    align-items: flex-end;
    gap: 0.5rem;
    line-height: 1.45;
  }

  .cv-heading strong {
    font-weight: 600;
  }

  .cv-leader {
    flex: 1 1 1.5rem;
    min-width: 1.5rem;
    margin-bottom: 0.4em;
    border-bottom: 1.5px dotted var(--ink-3);
    opacity: 0.6;
  }

  .cv-date {
    flex: 0 0 auto;
    color: var(--ink-3);
    font-size: 0.66rem;
    font-weight: 600;
    line-height: 2;
    white-space: nowrap;
  }

  .cv-detail {
    margin-top: 0.1rem;
    color: var(--ink-2);
    font-size: 0.93rem;
  }

  /* ===========================
     COLOPHON
  =========================== */
  .colophon {
    margin-top: 4rem;
    margin-bottom: 0;
    padding-top: 1.75rem;
    padding-bottom: 3rem;
    background: linear-gradient(var(--rule), var(--rule)) center 0 / calc(100% - 2 * var(--gutter)) 1px no-repeat;
    color: var(--ink-3);
    font-size: 0.88rem;
  }

  .colophon-body p + p {
    margin-top: 0.4rem;
  }

  .colophon-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1.25rem;
  }

  /* ===========================
     RESPONSIVE
  =========================== */
  @media (max-width: 1099px) {
    .title-grid {
      grid-template-columns: var(--rail) minmax(0, 1fr) 10rem;
    }

    /* Margin column folds into the text column */
    .prose {
      max-width: none;
    }

    /* Sidenotes duplicate the CV chapter; drop them rather than break the paragraph */
    .sidenote,
    .sn-ref {
      display: none;
    }

    .area,
    .pub {
      grid-template-columns: minmax(0, 1fr);
    }

    .area-gloss {
      grid-column: 1;
      grid-row: auto;
      flex-direction: row;
      align-items: baseline;
      gap: 0.6rem;
      margin-bottom: 0.25rem;
    }


    .area-body {
      grid-row: auto;
    }

    .pub-main {
      display: contents;
    }

    .pub-title { order: 1; }
    .pub-authors { order: 2; }
    .pub-venue { order: 3; }
    .pub-links { order: 4; }
    .pub-bib { order: 5; }

    .pub-venue {
      display: block;
      margin-top: 0.15rem;
      padding: 0;
      border: 0;
      font-size: 0.88rem;
    }

    .pub-venue > * + *::before {
      content: ' · ';
      color: var(--ink-3);
      font-style: normal;
    }

    .pub-note::before {
      content: ' · ';
    }
  }

  @media (max-width: 759px) {
    .nav-inner {
      gap: 0.75rem;
    }

    .nav-brand {
      display: none;
    }

    .nav-links {
      margin-left: 0;
      gap: 1.1rem;
    }

    .nav-link--pdf,
    .nav-num,
    .nav-label-long,
    .nav-link[href='#about'] {
      display: none;
    }

    .nav-label-short {
      display: inline;
    }

    .theme-toggle {
      margin-left: auto;
    }

    .title-grid {
      grid-template-columns: minmax(0, 1fr) 7rem;
      column-gap: 1.25rem;
      row-gap: 1.25rem;
    }

    .title-main {
      grid-column: 1 / -1;
      grid-row: 2;
    }

    .title-meta {
      grid-column: 1;
      grid-row: 1;
    }

    .title-figure {
      grid-column: 2;
      grid-row: 1;
    }

    .seals a {
      width: 24px;
      height: 24px;
    }

    .notice {
      grid-template-columns: minmax(0, 1fr);
    }

    :global(.chapter) {
      margin-top: 2.25rem;
      padding-top: 0;
      background: none;
    }

    .dispatches li {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    .toc li,
    .cv-line {
      flex-wrap: wrap;
      align-items: baseline;
    }

    .toc-name {
      max-width: none;
    }

    .toc-leader,
    .cv-leader {
      display: none;
    }

    .toc-venue::before,
    .cv-date::before {
      content: '— ';
    }

    .colophon {
      padding-top: 1.5rem;
      background: linear-gradient(var(--rule), var(--rule)) center 0 / calc(100% - 2 * var(--gutter)) 1px no-repeat;
    }
  }

  /* ===========================
     PRINT
  =========================== */
  @media print {
    .nav,
    .pub-filter,
    .pub-links,
    .notice,
    .theme-toggle {
      display: none !important;
    }

    :global(.js) .pub-list[data-filter='selected'] .pub,
    :global(.js) .pub-list[data-filter='selected'] .pub-year {
      display: grid !important;
    }

    :global(.js) .pub-list[data-filter='selected'] .pub-year {
      display: block !important;
    }

    .chapter-head {
      position: static;
    }
  }
</style>

<script>
  const root = document.documentElement;

  // Theme toggle (respects system preference until the visitor chooses)
  const darkQuery = matchMedia('(prefers-color-scheme: dark)');
  document.querySelector('.theme-toggle')?.addEventListener('click', () => {
    const current = root.dataset.theme ?? (darkQuery.matches ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      // Storage unavailable (private mode); the choice lasts for this page view.
    }
  });

  // Publication filter (Selected / All)
  const pubList = document.querySelector<HTMLElement>('.pub-list');
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('.pub-filter-btn');

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      pubList!.dataset.filter = button.dataset.filter;
      filterButtons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
    });
  });

  // BibTeX toggle and copy
  document.querySelectorAll<HTMLButtonElement>('.pub-bib-toggle').forEach((toggle) => {
    toggle.addEventListener('click', () => {
      const panel = document.getElementById(toggle.getAttribute('aria-controls')!)!;
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      panel.hidden = open;
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.pub-bib-copy').forEach((button) => {
    button.addEventListener('click', async () => {
      const pre = button.previousElementSibling!;
      try {
        await navigator.clipboard.writeText(pre.textContent ?? '');
        button.textContent = 'Copied';
      } catch {
        getSelection()?.selectAllChildren(pre);
        button.textContent = 'Selected';
      }
      setTimeout(() => (button.textContent = 'Copy'), 1600);
    });
  });

  // Show the name in the nav once the title-page name scrolls away
  const nav = document.querySelector<HTMLElement>('.nav')!;
  const titleName = document.querySelector('.title-name');
  if (titleName) {
    new IntersectionObserver(([entry]) => {
      nav.classList.toggle('is-condensed', !entry.isIntersecting);
    }, { rootMargin: '-48px 0px 0px 0px' }).observe(titleName);
  }

  // Active nav link
  const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('.nav-link[href^="#"]')];
  const sections = navLinks
    .map((link) => document.querySelector<HTMLElement>(link.getAttribute('href')!))
    .filter((section): section is HTMLElement => section !== null);

  let ticking = false;
  const update = () => {
    ticking = false;
    const max = document.documentElement.scrollHeight - innerHeight;

    const atBottom = scrollY >= max - 2;
    let current = '';
    if (atBottom) {
      current = sections[sections.length - 1]?.id ?? '';
    } else {
      sections.forEach((section) => {
        if (scrollY >= section.offsetTop - 160) current = section.id;
      });
    }
    navLinks.forEach((link) => {
      link.classList.toggle('active', link.getAttribute('href') === `#${current}`);
    });
  };

  addEventListener('scroll', () => {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(update);
    }
  }, { passive: true });
  addEventListener('resize', update);
  update();
</script>
