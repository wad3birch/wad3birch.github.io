  kind?: 'journal' | 'preprint';
  contribution?: string;
  note?: string;
  image?: string;
  imageAlt?: string;
};

const venueParts = (venue: string) => {
  const match = venue.match(/^(.*?)\s+(\d{4})$/);
  return match ? { label: match[1], year: match[2] } : { label: venue, year: '' };
};

