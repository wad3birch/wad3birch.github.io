    z-index: 100;
  }

  .nav-inner {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-padding);
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xl);
  }

  .nav-brand {
    flex: 0 0 auto;
    color: var(--nd-blue);
    font-family: var(--font-sans);
    font-size: 0.88rem;
    font-weight: 700;
    line-height: 1;
  }

  .nav-links {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1.75rem;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .nav-links::-webkit-scrollbar {
    display: none;
  }

  .nav-link {
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--text-secondary);
    padding: 4px 0;
    position: relative;
    white-space: nowrap;
    flex: 0 0 auto;
    transition: color 0.2s ease;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--nd-blue);
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 1px;
    background: var(--nd-gold);
  }

  /* ===========================
