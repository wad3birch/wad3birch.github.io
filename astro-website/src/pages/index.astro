    <div class="hero-inner">
      <div class="hero-avatar">
        <img src="/self.jpeg" alt="Portrait of Han Bao" />
      </div>
      <div class="hero-info">
        <h1 class="hero-name">Han Bao</h1>
        <p class="hero-affiliation">
          <span class="hero-role">Incoming Ph.D. Student in Computer Science &amp; Engineering</span>
          <a href="https://www.nd.edu/" target="_blank" rel="noopener" class="affiliation-link">
            University of Notre Dame
          </a>
        </p>
        <p class="hero-focus">
          I study reliable and aligned LLM agents, with an emphasis on failure diagnosis,
          deployment-time risks, and trustworthy evaluation.
        </p>
        <div class="contact-bar" id="contact">
          <a href="mailto:hbao@nd.edu" class="contact-item">Email</a>
          <span class="contact-sep">·</span>
          <a href="https://scholar.google.com/citations?user=X8gcICcAAAAJ" target="_blank" rel="noopener" class="contact-item">Google Scholar</a>
          <span class="contact-sep">·</span>
          <a href="https://github.com/wad3birch" target="_blank" rel="noopener" class="contact-item">GitHub</a>
          <span class="contact-sep">·</span>
          <a href="https://www.linkedin.com/in/han-bao-59796b379/" target="_blank" rel="noopener" class="contact-item">LinkedIn</a>
