                        <a href={work.href} target="_blank" rel="noopener">{work.name}</a>
                      ) : (
                        work.name
                      )}
                    </span>
                    <span class="toc-leader" aria-hidden="true"></span>
                    <span class="toc-venue">{work.venue}</span>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </Chapter>

    <Chapter id="publications" num="IV" title="Publications">
      <div class="pub-tools">
        <div class="pub-filter" role="group" aria-label="Filter publications">
          <button type="button" class="pub-filter-btn" data-filter="selected" aria-pressed="true">Selected ({selectedCount})</button>
          <span class="pub-filter-sep" aria-hidden="true">/</span>
          <button type="button" class="pub-filter-btn" data-filter="all" aria-pressed="false">All ({publications.length})</button>
        </div>
        <p class="pub-legend">
          * Equal contribution. See also
          <a href="https://scholar.google.com/citations?user=X8gcICcAAAAJ" target="_blank" rel="noopener">Google Scholar</a>.
        </p>
      </div>

      <div class="pub-list" data-filter="selected">
        {publicationYears.map((year) => {
          const papers = publications.filter((p) => p.year === year);
          return (
            <div class:list={['pub-year', papers.some((p) => p.selected) && 'pub-year--has-selected']}>
              <h3 class="pub-year-label"><span>{year}</span></h3>
              <ol class="pub-entries">
                {papers.map((paper) => {
                  const href = primaryLink(paper);
                  const key = bibKey(paper);
                  return (
                    <li class:list={['pub', paper.selected && 'pub--selected']} id={`pub-${key}`}>
                      <div class="pub-main">
                        <h4 class="pub-title">
                          {href ? (
                            <a href={href} target="_blank" rel="noopener">{paper.title}</a>
                          ) : (
                            paper.title
                          )}
                        </h4>
                        <p class="pub-authors">
                          {paper.authors.map((author, index) => (
                            <>
                              {index > 0 && ', '}
                              {author.me ? (
                                <strong>{author.name}{author.equal && '*'}</strong>
                              ) : (
                                <>{author.name}{author.equal && '*'}</>
                              )}
                            </>
                          ))}
                        </p>
                        <p class="pub-links">
                          {paperLinks(paper).map((link) => (
                            <a href={link.href} target="_blank" rel="noopener" class="pub-link">{link.label}</a>
                          ))}
                          <button
                            type="button"
                            class="pub-link pub-bib-toggle"
                            aria-expanded="false"
                            aria-controls={`bib-${key}`}
                          >BibTeX</button>
                        </p>
                        <div class="pub-bib" id={`bib-${key}`} hidden>
                          <pre>{toBibtex(paper)}</pre>
                          <button type="button" class="pub-bib-copy">Copy</button>
                        </div>
                      </div>
                      <p class:list={['pub-venue', paper.kind === 'preprint' && 'pub-venue--preprint']}>
                        <span class="pub-venue-short">{paper.venue}</span>
                        {paper.venueFull && <span class="pub-venue-full">{paper.venueFull}</span>}
                        {paper.note && <span class="pub-note">{paper.note}</span>}
                      </p>
                    </li>
                  );
                })}
              </ol>
            </div>
          );
        })}
      </div>
    </Chapter>

    <Chapter id="cv" num="V" title="Curriculum Vitae">
      <div class="cv">
        <section class="cv-block" id="education" aria-labelledby="education-title">
          <h3 class="cv-label" id="education-title">Education</h3>
          <ul class="cv-entries">
            <li>
              <p class="cv-line">
                <span class="cv-heading"><strong>University of Notre Dame</strong></span>
                <span class="cv-leader" aria-hidden="true"></span>
                <span class="cv-date">Sep 2026 – Present</span>
              </p>
              <p class="cv-detail">
                Ph.D. in Computer Science · Advisor:
                <a href="https://engineering.nd.edu/faculty/yanfang-fanny-ye/" target="_blank" rel="noopener">Prof. Fanny Ye</a>
              </p>
            </li>
            <li>
              <p class="cv-line">
                <span class="cv-heading"><strong>Sichuan University</strong></span>
                <span class="cv-leader" aria-hidden="true"></span>
                <span class="cv-date">Sep 2021 – Jun 2026</span>
              </p>
              <p class="cv-detail">B.Eng. in Cyber Science and Engineering</p>
            </li>
          </ul>
        </section>

        <section class="cv-block" id="experience" aria-labelledby="experience-title">
          <h3 class="cv-label" id="experience-title">Research Experience</h3>
          <ul class="cv-entries">
            <li>
              <p class="cv-line">
                <span class="cv-heading"><strong>University of Notre Dame</strong>, Visiting Research Student</span>
                <span class="cv-leader" aria-hidden="true"></span>
                <span class="cv-date">Aug 2024 – Present</span>
              </p>
              <p class="cv-detail">
                Advisor: <a href="https://sites.nd.edu/xiangliang-zhang/" target="_blank" rel="noopener">Prof. Xiangliang Zhang</a>
                · Trustworthy Generative Models, LLM Alignment, Agent Evaluation
              </p>
            </li>
            <li>
              <p class="cv-line">
                <span class="cv-heading"><strong>National University of Singapore</strong>, Summer Workshop Participant</span>
                <span class="cv-leader" aria-hidden="true"></span>
                <span class="cv-date">Jul 2024</span>
              </p>
              <p class="cv-detail">Advisor: Prof. Tianbai Ma · Cloud Computing, Network Traffic Analysis</p>
            </li>
          </ul>
        </section>

        <section class="cv-block" id="awards" aria-labelledby="awards-title">
          <h3 class="cv-label" id="awards-title">Honors &amp; Awards</h3>
          <ul class="cv-entries">
            {awards.map((award) => (
              <li>
                <p class="cv-line">
                  <span class="cv-heading">{award.title}</span>
                  <span class="cv-leader" aria-hidden="true"></span>
                  <span class="cv-date">{award.date}</span>
                </p>
                <p class="cv-detail">{award.org}</p>
              </li>
            ))}
          </ul>
        </section>

        <section class="cv-block" id="service" aria-labelledby="service-title">
          <h3 class="cv-label" id="service-title">Academic Service</h3>
          <ul class="cv-entries">
            {service.map((item) => (
              <li>
                <p class="cv-line">
                  <span class="cv-heading">{item.role}</span>
                  <span class="cv-leader" aria-hidden="true"></span>
                  <span class="cv-date">{item.date}</span>
                </p>
                <p class="cv-detail">{item.venue}</p>
              </li>
            ))}
          </ul>
        </section>
      </div>
    </Chapter>
  </main>

  <footer class="wrap chapter colophon">
    <div aria-hidden="true"></div>
    <div class="colophon-body">
      <p>
        Set in Source Serif 4. Built with Astro and published on GitHub Pages.
        Last revised {lastUpdated}.
      </p>
      <p class="colophon-meta">
        <span>&copy; {buildDate.getFullYear()} Han Bao</span>
        <a href="mailto:hbao@nd.edu">hbao@nd.edu</a>
        <a href="#top">Back to top ↑</a>
      </p>
    </div>
  </footer>
</Layout>

<style>
  /* Small-caps label used across the page */
  .kicker,
  .nav-link,
  .title-meta dt,
  .notice-label,
  .dispatch-date,
  .toc-venue,
  .pub-filter,
  .pub-link,
  .pub-venue-short,
  .cv-label,
  .cv-date {
    font-variant-numeric: lining-nums;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  /* ===========================
     NAV
  =========================== */
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
    transition: background-color 0.25s ease;
  }

  .nav-inner {
