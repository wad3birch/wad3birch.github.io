    <Chapter id="publications" num="IV" title="Publications">
      <div class="pub-tools">
        <div class="pub-filter" role="group" aria-label="Filter publications">
          <button type="button" class="pub-filter-btn" data-filter="selected" aria-pressed="true">Selected ({selectedCount})</button>
          <span class="pub-filter-sep" aria-hidden="true">/</span>
          <button type="button" class="pub-filter-btn" data-filter="all" aria-pressed="false">All ({publications.length})</button>
        </div>
        <p class="pub-legend">
          * Equal contribution. See also
          <a href="https://scholar.google.com/citations?user=X8gcICcAAAAJ" target="_blank" rel="noopener">Google Scholar</a>.
        </p>
      </div>

      <div class="pub-list" data-filter="selected">
        {publicationYears.map((year) => {
          const papers = publications.filter((p) => p.year === year);
          return (
            <div class:list={['pub-year', papers.some((p) => p.selected) && 'pub-year--has-selected']}>
              <h3 class="pub-year-label">
                <span>{year}</span>
                <small class="pub-year-count pub-year-count--all">{papers.length} {papers.length === 1 ? 'paper' : 'papers'}</small>
                <small class="pub-year-count pub-year-count--selected">{papers.filter((p) => p.selected).length} selected</small>
              </h3>
              <ol class="pub-entries">
                {papers.map((paper) => {
                  const href = primaryLink(paper);
                  const key = bibKey(paper);
                  return (
                    <li class:list={['pub', paper.selected && 'pub--selected']} id={`pub-${key}`}>
                      {(() => {
                        const thumb = thumbFor(key);
                        const inner = thumb ? (
                          <Image src={thumb} alt="" widths={[240, 480]} sizes="(max-width: 759px) 6rem, 10.5rem" format="webp" loading="lazy" />
                        ) : (
                          <span class="pub-thumb-ph">
                            <span class="pub-thumb-ph-venue">{paper.venue.split(' ')[0]}</span>
                            <span class="pub-thumb-ph-year">{paper.year}</span>
                          </span>
                        );
                        return href ? (
                          <a class="pub-thumb" href={href} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">{inner}</a>
                        ) : (
                          <span class="pub-thumb" aria-hidden="true">{inner}</span>
                        );
                      })()}
                      <div class="pub-main">
                        <p class:list={['pub-venue', paper.kind === 'preprint' && 'pub-venue--preprint']}>
                          <span class="pub-venue-short">{paper.venue}</span>
                          {paper.venueFull && <span class="pub-venue-full">{paper.venueFull}</span>}
                          {paper.note && <span class="pub-note">{paper.note}</span>}
                        </p>
                        <h4 class="pub-title">
                          {href ? (
                            <a href={href} target="_blank" rel="noopener">{paper.title}</a>
                          ) : (
                            paper.title
                          )}
                        </h4>
                        <p class="pub-authors">
                          {paper.authors.map((author, index) => (
                            <>
                              {index > 0 && ', '}
                              {author.me ? (
                                <strong>{author.name}{author.equal && '*'}</strong>
                              ) : (
                                <>{author.name}{author.equal && '*'}</>
                              )}
                            </>
                          ))}
                        </p>
                        <p class="pub-links">
                          {paperLinks(paper).map((link) => (
                            <a href={link.href} target="_blank" rel="noopener" class="pub-link">{link.label}</a>
                          ))}
                          <button
                            type="button"
                            class="pub-link pub-bib-toggle"
                            aria-expanded="false"
                            aria-controls={`bib-${key}`}
                          >BibTeX</button>
                        </p>
                        <div class="pub-bib" id={`bib-${key}`} hidden>
                          <pre>{toBibtex(paper)}</pre>
                          <button type="button" class="pub-bib-copy">Copy</button>
                        </div>
                      </div>
                    </li>
                  );
                })}
              </ol>
            </div>
          );
        })}
      </div>
