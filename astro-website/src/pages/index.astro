  .notice-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--gold-text);
    font-size: 0.68rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .notice-dot {
    position: relative;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--live);
  }

  .notice-text {
    color: var(--ink-2);
    line-height: 1.55;
  }

  /* ===========================
     CHAPTERS (shared spacing)
  =========================== */
  /* Rule drawn as a background so it stops at the content edge, not the gutter */
  :global(.chapter) {
    margin-top: 3rem;
    padding-top: 2.25rem;
    background: linear-gradient(var(--rule), var(--rule)) center top / calc(100% - 2 * var(--gutter)) 1px no-repeat;
  }

  /* ===========================
     I. ABOUT
  =========================== */
  .prose {
    counter-reset: sidenote;
    max-width: calc(100% - var(--margin) - var(--gap));
  }

  .prose p {
    color: var(--ink-2);
  }

  .prose p + p {
    margin-top: 0.85rem;
  }

  .prose strong {
    color: var(--ink);
    font-weight: 600;
  }

  .sn-ref::after {
    counter-increment: sidenote;
    content: counter(sidenote);
    position: relative;
    top: -0.5em;
    margin-left: 0.08em;
    font-size: 0.7em;
    color: var(--gold-text);
    font-variant-numeric: lining-nums;
  }

  .sidenote {
    float: right;
    clear: right;
    width: var(--margin);
    margin-right: calc(-1 * (var(--margin) + var(--gap)));
    margin-top: 0.2rem;
    margin-bottom: 0.75rem;
    color: var(--ink-3);
    font-size: 0.82rem;
    line-height: 1.45;
  }

  .sidenote::before {
    content: counter(sidenote) '. ';
    color: var(--gold-text);
    font-variant-numeric: lining-nums;
  }

  /* ===========================
     II. NEWS
  =========================== */
  .dispatches {
    position: relative;
    list-style: none;
    max-width: 46rem;
  }

  /* Timeline spine */
  .dispatches::before {
    content: '';
    position: absolute;
    left: 3px;
    top: 0.6rem;
    bottom: 0.6rem;
    width: 1px;
    background: var(--rule);
  }

  .dispatches li {
    position: relative;
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 1rem;
    padding: 0.45rem 0 0.45rem 1.5rem;
    color: var(--ink-2);
    line-height: 1.55;
  }

  .dispatches li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.9rem;
    width: 7px;
    height: 7px;
    border: 1.5px solid var(--gold);
    border-radius: 50%;
    background: var(--paper);
  }

  .dispatches li:first-child::before {
    background: var(--gold);
    box-shadow: 0 0 0 3px rgba(var(--gold-rgb), 0.18);
  }

  .dispatches li:first-child .dispatch-date::after {
    content: 'New';
    display: block;
    width: fit-content;
    margin-top: 0.25rem;
    padding: 0 0.35rem;
    border-radius: 2px;
    background: var(--gold);
    color: #fff;
    font-size: 0.58rem;
    line-height: 1.6;
  }

  .dispatch-date {
    padding-top: 0.2rem;
    color: var(--gold-text);
    font-size: 0.68rem;
    font-weight: 600;
    white-space: nowrap;
  }

  /* ===========================
     III. RESEARCH
  =========================== */
  .research-thesis {
    max-width: 44rem;
    margin-bottom: 0.6rem;
    color: var(--ink-2);
    font-size: 1.28rem;
    line-height: 1.55;
  }

  .research-thesis strong {
    color: var(--ink);
    font-weight: 600;
  }

  .research-thesis .kw {
    color: var(--ac);
    font-weight: 600;
    background: linear-gradient(currentColor, currentColor) left bottom / 100% 1px no-repeat;
    padding-bottom: 0.05em;
  }

  .area {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    column-gap: 1.75rem;
    padding: 1.6rem 0;
  }

  .area + .area {
    border-top: 1px dotted var(--rule);
  }

  .area:last-child {
    padding-bottom: 0.5rem;
  }

  /* Line illustration */
  .area-art {
    display: grid;
    place-items: center;
    width: 5.5rem;
    height: 5.5rem;
    border: 1px solid var(--rule);
    border-radius: 6px;
    transition: border-color 0.25s ease;
  }

  .area:hover .area-art {
    border-color: var(--ac);
  }

  .area-art svg {
    width: 4.6rem;
    height: 4.6rem;
    overflow: visible;
  }

  .area-art path,
  .area-art rect,
  .area-art circle {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .area-art .ln {
    stroke: var(--ink-3);
    stroke-width: 1.5;
  }

  .area-art .gd {
    stroke: var(--ac, var(--gold));
    stroke-width: 1.8;
  }

  .area-art .dash {
    stroke-dasharray: 2 3;
    opacity: 0.7;
  }

  .area-art .bar {
    stroke: var(--ink-3);
    stroke-width: 4.5;
    stroke-linecap: butt;
    opacity: 0.45;
  }

  .area-art .bar--gold {
    stroke: var(--ac, var(--gold));
    opacity: 1;
  }

  .area-art .dot {
    fill: var(--accent);
    stroke: none;
    transition: opacity 0.4s ease calc(var(--a, 0) * 0.25s + var(--d, 0) * 0.3s + 0.3s);
  }

  .area-art .dot--gold {
    fill: var(--ac, var(--gold));
  }

  .area-art .draw {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 0.9s cubic-bezier(0.2, 0.7, 0.2, 1)
      calc(var(--a, 0) * 0.25s + var(--d, 0) * 0.3s + 0.2s);
  }

  :global(html.js) .chapter:not(.is-in) .area-art .draw {
    stroke-dashoffset: 1;
  }

  :global(html.js) .chapter:not(.is-in) .area-art .dot {
    opacity: 0;
  }

  .area:hover .area-art .redraw {
    animation: redraw 1s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  @keyframes redraw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  /* Text */
  .area-body {
    min-width: 0;
    max-width: 44rem;
  }

  .area-kicker {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    color: var(--ac, var(--gold-text));
    font-size: 0.66rem;
    font-weight: 600;
  }

  .area-num {
    color: var(--ink-3);
  }

  .area-q {
    margin-top: 0.35rem;
    color: var(--accent);
    font-size: 1.32rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.005em;
  }

  .area-text {
    margin-top: 0.55rem;
    color: var(--ink-2);
    line-height: 1.6;
  }

  /* Selected work as tags */
  .works {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 0.85rem;
    list-style: none;
  }

  .work {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.2rem 0.7rem 0.22rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    color: var(--ink);
    font-size: 0.88rem;
    line-height: 1.4;
    text-decoration: none;
    transition: border-color 0.15s ease, background-color 0.15s ease, color 0.15s ease;
  }

  a.work:hover {
    border-color: var(--ac, var(--gold));
    background: var(--paper-2);
    color: var(--ink);
  }

  .work-venue {
    color: var(--ac, var(--gold-text));
    font-size: 0.6rem;
    font-weight: 600;
  }

  .work-venue::before {
    content: '·';
    margin-right: 0.5rem;
    color: var(--ink-3);
  }

  /* Jump links reserve room for a small arrow that appears on hover */
  a.jump {
    padding-right: 0.4rem;
  }

  a.jump::after {
    content: '↓';
    display: inline-block;
    width: 0.9em;
    margin-left: -0.15rem;
    opacity: 0;
    color: var(--gold-text);
    font-size: 0.78rem;
    text-align: center;
    transform: translateY(-0.15em);
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  a.jump:hover::after {
    opacity: 1;
    transform: translateY(0.05em);
  }

  /* ===========================
     IV. PUBLICATIONS
  =========================== */
  .pub-tools {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
  }

  .pub-filter {
    display: none;
    align-items: baseline;
    gap: 0.6rem;
    font-size: 0.7rem;
    font-weight: 600;
  }

  :global(.js) .pub-filter {
    display: inline-flex;
  }

  .pub-filter-btn {
    padding: 0.1rem 0;
    border: 0;
    border-bottom: 1px solid transparent;
    background: none;
    color: var(--ink-3);
    letter-spacing: inherit;
    text-transform: inherit;
    cursor: pointer;
  }

  .pub-filter-btn:hover {
    color: var(--ink);
  }

  .pub-filter-btn[aria-pressed='true'] {
    color: var(--ink);
    border-bottom-color: var(--gold);
  }

  .pub-filter-sep {
    color: var(--rule);
  }

  .pub-legend {
    color: var(--ink-3);
    font-size: 0.88rem;
    font-style: italic;
  }

  .pub-year-label {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 1.5rem 0 0.3rem;
    font-size: 0.95rem;
    font-weight: 600;
    font-variant-numeric: lining-nums;
    color: var(--ink-3);
  }

  .pub-year-label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--rule);
  }

  .pub-entries {
    list-style: none;
  }

  .pub {
    display: grid;
    grid-template-columns: 10.5rem minmax(0, 1fr);
    column-gap: 1.6rem;
    align-items: start;
    padding: 1.1rem 0;
    line-height: 1.45;
  }

  /* Paper figure thumbnail */
  .pub-thumb {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: #fff;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .pub-thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 0.3rem;
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .pub:hover .pub-thumb {
    border-color: rgba(var(--gold-rgb), 0.7);
    box-shadow: 0 8px 22px -16px rgba(0, 0, 0, 0.4);
  }

  .pub:hover .pub-thumb :global(img) {
    transform: scale(1.05);
  }

  .pub-thumb-ph {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.15rem;
    width: 100%;
    height: 100%;
    background:
      linear-gradient(var(--gold), var(--gold)) center 62% / 1.25rem 2px no-repeat,
      var(--paper-2);
  }

  .pub-thumb-ph-venue {
    margin-bottom: 0.45rem;
    color: var(--accent);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .pub-thumb-ph-year {
    color: var(--ink-3);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    font-variant-numeric: lining-nums;
  }

  .pub + .pub {
    border-top: 1px dotted var(--rule);
  }

  .pub {
    position: relative;
  }

  .pub::before {
    content: '';
    position: absolute;
    left: -1rem;
    top: 0.95rem;
    bottom: 0.95rem;
    width: 2px;
    background: var(--gold);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.25s ease;
  }

  .pub:hover::before,
  .pub.is-flash::before {
    transform: scaleY(1);
  }

  .pub.is-flash {
    animation: pub-flash 2.2s ease-out;
  }

  @keyframes pub-flash {
    0%, 35% {
      background: rgba(var(--gold-rgb), 0.1);
    }
    100% {
      background: transparent;
    }
  }

  :global(.js) .pub-list[data-filter='selected'] .pub:not(.pub--selected),
  :global(.js) .pub-list[data-filter='selected'] .pub-year:not(.pub-year--has-selected) {
    display: none;
  }

  /* Re-draw separators so the first visible entry in Selected view has none */
  :global(.js) .pub-list[data-filter='selected'] .pub--selected {
    border-top: 0;
  }

  :global(.js) .pub-list[data-filter='selected'] .pub--selected ~ .pub--selected {
    border-top: 1px dotted var(--rule);
  }

  .pub-main {
    min-width: 0;
  }

  .pub-title {
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .pub-title a {
    text-decoration-color: transparent;
  }

  .pub-title a:hover {
    text-decoration-color: currentColor;
  }

  .pub-authors {
    margin-top: 0.2rem;
    color: var(--ink-2);
    font-size: 0.93rem;
  }

  .pub-authors strong {
    color: var(--ink);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: rgba(var(--gold-rgb), 0.7);
    text-underline-offset: 0.2em;
  }

  .pub-links {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0;
    margin-top: 0.35rem;
  }

  .pub-link {
    padding: 0;
    border: 0;
    background: none;
    color: var(--link);
    font-size: 0.66rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
  }

  .pub-link:not(:last-child)::after {
    content: '·';
    display: inline-block;
    margin: 0 0.55rem;
    color: var(--ink-3);
  }

  .pub-link:hover,
  .pub-bib-toggle[aria-expanded='true'] {
    color: var(--gold-text);
  }

  .pub-bib {
    position: relative;
    margin-top: 0.55rem;
  }

  .pub-bib pre {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    padding: 0.75rem 4.25rem 0.75rem 0.9rem;
    border-left: 2px solid var(--gold);
    background: var(--paper-2);
    color: var(--ink);
    font-size: 0.74rem;
    line-height: 1.55;
  }

  .pub-bib-copy {
    position: absolute;
    top: 0.45rem;
    right: 0.45rem;
    padding: 0.05rem 0.5rem;
    border: 1px solid var(--rule);
    border-radius: 2px;
    background: var(--paper);
    color: var(--ink-2);
    font-size: 0.7rem;
    cursor: pointer;
  }

  .pub-bib-copy:hover {
    border-color: var(--gold);
  }

  .pub-venue {
    margin-bottom: 0.2rem;
    color: var(--ink-3);
    font-size: 0.84rem;
    line-height: 1.4;
  }

  .pub-venue > * + *::before {
    content: ' · ';
    color: var(--ink-3);
    font-style: normal;
  }

  .pub-venue-short {
    color: var(--gold-text);
    font-size: 0.68rem;
    font-weight: 600;
  }

  .pub-venue--preprint .pub-venue-short {
    color: var(--ink-3);
  }

  .pub-venue-full {
    color: var(--ink-3);
    font-style: italic;
  }

  .pub-note {
    font-style: italic;
  }

  .pub-note {
    color: var(--gold-text);
  }

  /* ===========================
     V. CURRICULUM VITAE
  =========================== */
  .cv {
    display: flex;
    flex-direction: column;
    gap: 1.9rem;
    max-width: 46rem;
  }

  .cv-block {
    scroll-margin-top: 4rem;
  }

  .cv-label {
    margin-bottom: 0.7rem;
    color: var(--gold-text);
    font-size: 0.68rem;
  }

  .cv-entries {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .cv-line {
    display: flex;
    align-items: flex-end;
    gap: 0.5rem;
    line-height: 1.45;
  }

  .cv-heading strong {
    font-weight: 600;
  }

  .cv-leader {
    flex: 1 1 1.5rem;
    min-width: 1.5rem;
    margin-bottom: 0.4em;
    border-bottom: 1.5px dotted var(--ink-3);
    opacity: 0.6;
  }

  .cv-date {
    flex: 0 0 auto;
    color: var(--ink-3);
    font-size: 0.66rem;
    font-weight: 600;
    line-height: 2;
    white-space: nowrap;
  }

  .cv-detail {
    margin-top: 0.1rem;
    color: var(--ink-2);
    font-size: 0.93rem;
  }

  /* ===========================
     COLOPHON
  =========================== */
  .colophon {
    margin-top: 4rem;
    margin-bottom: 0;
    padding-top: 1.75rem;
    padding-bottom: 3rem;
    background: linear-gradient(var(--rule), var(--rule)) center 0 / calc(100% - 2 * var(--gutter)) 1px no-repeat;
    color: var(--ink-3);
    font-size: 0.88rem;
  }

  .colophon-body p + p {
    margin-top: 0.4rem;
  }

  .colophon-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1.25rem;
  }

  /* ===========================
     SEARCH BUTTON
  =========================== */
  .search-btn {
    flex: 0 0 auto;
    display: none;
    align-items: center;
    gap: 0.45rem;
    height: 2rem;
    padding: 0 0.45rem 0 0.65rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: transparent;
    color: var(--ink-3);
    font-size: 0.8rem;
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  :global(.js) .search-btn {
    display: inline-flex;
  }

  .search-btn:hover {
    border-color: var(--gold);
    color: var(--ink);
  }

  .search-kbd,
  .palette kbd {
    padding: 0 0.3rem;
    border: 1px solid var(--rule);
    border-radius: 3px;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    line-height: 1.5;
  }

  /* ===========================
     "CURRENTLY" LINE
  =========================== */
  .now {
    margin-top: 0.85rem;
    color: var(--ink-2);
    font-size: 0.98rem;
  }

  .now-label {
    display: inline-block;
    margin-right: 0.6rem;
    padding: 0 0.4rem;
    border: 1px solid rgba(var(--gold-rgb), 0.55);
    border-radius: 2px;
    color: var(--gold-text);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: 1.7;
    text-transform: uppercase;
    vertical-align: 0.12em;
  }

  .now-text {
    font-style: italic;
  }

  .now-caret {
    display: inline-block;
    width: 1.5px;
    height: 1.05em;
    margin-left: 2px;
    background: var(--gold);
    vertical-align: -0.15em;
    animation: caret 1.05s steps(1) infinite;
  }

  @keyframes caret {
    50% {
      opacity: 0;
    }
  }

  /* ===========================
     STATS
  =========================== */
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 2.75rem;
    margin-top: 2.25rem;
    margin-left: calc(var(--rail) + var(--gap));
  }

  .stat {
    display: flex;
    flex-direction: column;
  }

  .stat::before {
    content: '';
    width: 1.25rem;
    height: 2px;
    margin-bottom: 0.6rem;
    background: var(--gold);
  }

  .stat-num,
  .stat-venues {
    color: var(--accent);
    font-weight: 600;
    font-variant-numeric: lining-nums tabular-nums;
  }

  .stat-num {
    font-size: 2rem;
    line-height: 1;
  }

  .stat-venues {
    font-size: 0.98rem;
    line-height: 2rem;
    letter-spacing: 0.03em;
  }

  .stat-label {
    margin-top: 0.4rem;
    color: var(--ink-3);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  /* ===========================
     HIGHLIGHTER
  =========================== */
  mark.hl {
    padding: 0 0.08em;
    color: inherit;
    background: linear-gradient(
        transparent 58%,
        rgba(var(--gold-rgb), 0.3) 58%,
        rgba(var(--gold-rgb), 0.3) 92%,
        transparent 92%
      )
      no-repeat left / 0% 100%;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    transition: background-size 1.3s cubic-bezier(0.2, 0.7, 0.2, 1) 0.25s;
  }

  mark.hl.is-on,
  :global(html:not(.js)) mark.hl {
    background-size: 100% 100%;
  }

  /* ===========================
     COMMAND PALETTE
  =========================== */
  .palette {
    width: min(36rem, calc(100% - 2rem));
    margin: 12vh auto auto;
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: 8px;
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 30px 70px -25px rgba(0, 0, 0, 0.35);
  }

  .palette::backdrop {
    background: rgba(15, 18, 24, 0.3);
    backdrop-filter: blur(2px);
  }

  .palette[open] {
    animation: palette-in 0.16s ease-out;
  }

  @keyframes palette-in {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.99);
    }
  }

  .palette-row {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--rule);
  }

  .palette-prompt {
    color: var(--gold);
    font-family: var(--font-mono);
    font-weight: 600;
  }

  .palette-input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 1.05rem;
  }

  .palette-input::placeholder {
    color: var(--ink-3);
    opacity: 0.8;
  }

  .palette-list {
    list-style: none;
    max-height: min(55vh, 25rem);
    overflow-y: auto;
    padding: 0.35rem;
  }

  .palette-list :global(.pg) {
    padding: 0.55rem 0.65rem 0.2rem;
    color: var(--ink-3);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .palette-list :global(.pi) {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    padding: 0.42rem 0.65rem;
    border-radius: 5px;
    font-size: 0.94rem;
    cursor: pointer;
  }

  .palette-list :global(.pi[aria-selected='true']) {
    background: var(--paper-2);
    box-shadow: inset 2px 0 0 var(--gold);
  }

  .palette-list :global(.pi-label) {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .palette-list :global(.pi-meta) {
    flex: 0 0 auto;
    margin-left: auto;
    color: var(--ink-3);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .palette-list :global(.pi-empty) {
    padding: 1rem 0.65rem;
    color: var(--ink-3);
    font-style: italic;
  }

  .palette-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1.1rem;
    padding: 0.55rem 1rem;
    border-top: 1px solid var(--rule);
    color: var(--ink-3);
    font-size: 0.72rem;
  }

  .palette-foot kbd {
    margin-right: 0.2rem;
  }

  .palette-foot b {
    color: var(--gold-text);
    font-family: var(--font-mono);
    font-weight: 600;
  }

  :global(.toast) {
    position: fixed;
    left: 50%;
    bottom: 1.5rem;
    z-index: 300;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.82rem;
    transform: translateX(-50%);
    animation: toast 2s ease forwards;
    pointer-events: none;
  }

  @keyframes toast {
    0% { opacity: 0; transform: translate(-50%, 6px); }
    12%, 80% { opacity: 1; transform: translate(-50%, 0); }
    100% { opacity: 0; }
  }

  /* ===========================
     SMALL DETAILS
  =========================== */
  /* Local time in Notre Dame */
  .meta-time {
    display: none;
  }

  :global(.js) .meta-time {
    display: block;
  }

  .clock {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-variant-numeric: lining-nums tabular-nums;
  }

  .clock-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--gold);
    box-shadow: 0 0 0 3px rgba(var(--gold-rgb), 0.18);
  }

  .clock.is-night .clock-dot {
    background: var(--paper);
    box-shadow: inset 0 0 0 1.5px var(--ink-3);
  }

  .clock-diff {
    display: block;
    color: var(--ink-3);
    font-size: 0.78rem;
    font-style: italic;
  }

  /* Publication counts beside each year */
  .pub-year-count {
    color: var(--ink-3);
    font-size: 0.74rem;
    font-weight: 400;
    font-style: italic;
  }

  .pub-year-count--selected {
    display: none;
  }

  :global(.js) .pub-list[data-filter='selected'] .pub-year-count--all {
    display: none;
  }

  :global(.js) .pub-list[data-filter='selected'] .pub-year-count--selected {
    display: inline;
  }

  /* Sidenote and its reference light up together */
  .sn-ref,
  .sidenote {
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  .sn-ref.is-linked::after {
    color: var(--ink);
    font-weight: 600;
  }

  .sidenote.is-linked {
    color: var(--ink);
  }

  /* Venue names in News read as highlighted, like a journal's italic citations */
  .dispatches a {
    color: var(--gold-text);
    font-style: italic;
    text-decoration-color: rgba(var(--gold-rgb), 0.35);
  }

  .dispatches a:hover {
    color: var(--accent);
  }

  /* External links reveal a small arrow on hover (no layout shift) */
  .prose a[target='_blank']::after,
  .dispatches a[target='_blank']::after,
  .title-meta a[target='_blank']::after {
    content: '↗';
    display: inline-block;
    width: 0;
    font-size: 0.68em;
    opacity: 0;
    transform: translate(0.05em, -0.35em);
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  .prose a[target='_blank']:hover::after,
  .dispatches a[target='_blank']:hover::after,
  .title-meta a[target='_blank']:hover::after {
    opacity: 1;
    transform: translate(0.2em, -0.5em);
  }

  /* Portrait: a slow, slight zoom on hover */
  .portrait img {
    transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .portrait:hover img {
    transform: scale(1.035);
  }

  /* Back-to-top with page progress ring */
  .to-top {
    position: fixed;
    right: clamp(1rem, 3vw, 2rem);
    bottom: clamp(1rem, 3vw, 2rem);
    z-index: 90;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--paper);
    color: var(--ink-2);
    box-shadow: 0 6px 18px -8px rgba(0, 0, 0, 0.25);
    opacity: 0;
    transform: translateY(8px);
    pointer-events: none;
    text-decoration: none;
    transition: opacity 0.25s ease, transform 0.25s ease, color 0.15s ease;
  }

  .to-top.is-shown {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .to-top:hover {
    color: var(--gold-text);
  }

  .to-top svg {
    transform: rotate(-90deg);
  }

  .to-top path {
    transform: rotate(90deg);
    transform-origin: 20px 20px;
  }

  .to-top circle {
    fill: none;
    stroke-width: 1.5;
  }

  .to-top-track {
    stroke: var(--rule);
  }

  .to-top-ring {
    stroke: var(--gold);
    stroke-dasharray: 100;
    stroke-dashoffset: calc(100 - 100 * var(--page, 0));
    stroke-linecap: round;
  }

  /* Footer sign-off */
  .colophon-thanks {
    color: var(--ink-2);
    font-style: italic;
  }

  .colophon-hint {
    display: none;
  }

  :global(.js) .colophon-hint {
    display: block;
  }

  @media (hover: none) {
    :global(.js) .colophon-hint {
      display: none;
    }
  }

  /* ===========================
     RESPONSIVE
  =========================== */
  @media (max-width: 1099px) {
    .title-grid {
      grid-template-columns: var(--rail) minmax(0, 1fr) 10rem;
    }

    /* Margin column folds into the text column */
    .prose {
      max-width: none;
    }

    /* Sidenotes duplicate the CV chapter; drop them rather than break the paragraph */
    .sidenote,
    .sn-ref {
      display: none;
    }

    .pub {
      grid-template-columns: 8.5rem minmax(0, 1fr);
      column-gap: 1.25rem;
    }
  }

  @media (max-width: 759px) {
    .nav-inner {
      gap: 0.75rem;
    }

    .nav-brand {
      display: none;
    }

    .nav-links {
      margin-left: 0;
      gap: 1.1rem;
    }

    .nav-link--pdf,
    .nav-num,
    .nav-label-long,
    .nav-link[href='#about'] {
      display: none;
    }

    .nav-label-short {
      display: inline;
    }

    .search-btn {
      width: 2rem;
      margin-left: auto;
      padding: 0;
      justify-content: center;
    }

    .search-label,
    .search-kbd,
    .palette-foot span:last-child {
      display: none;
    }

    .stats {
      margin-left: 0;
      gap: 1.1rem 1.75rem;
    }

    .stat-num {
      font-size: 1.65rem;
    }

    .stat--venues {
      flex-basis: 100%;
    }

    .to-top {
      width: 36px;
      height: 36px;
    }

    .now {
      min-height: 3.4em;
    }

    .pub::before {
      display: none;
    }

    .pub {
      grid-template-columns: 5.75rem minmax(0, 1fr);
      column-gap: 0.9rem;
    }

    .pub-venue-full {
      display: none;
    }

    .pub-thumb-ph-venue {
      margin-bottom: 0.3rem;
      font-size: 0.82rem;
    }

    .pub-thumb-ph {
      background-position: center 64%, 0 0;
      background-size: 0.9rem 2px, auto;
    }

    .dispatches li {
      padding-left: 1.4rem;
    }

    .title-grid {
      grid-template-columns: minmax(0, 1fr) 7rem;
      column-gap: 1.25rem;
      row-gap: 1.25rem;
    }

    .title-main {
      grid-column: 1 / -1;
      grid-row: 2;
    }

    .title-meta {
      grid-column: 1;
      grid-row: 1;
    }

    .title-figure {
      grid-column: 2;
      grid-row: 1;
    }

    .seals a {
      width: 24px;
      height: 24px;
    }

    .notice {
      grid-template-columns: minmax(0, 1fr);
    }

    :global(.chapter) {
      margin-top: 2.25rem;
      padding-top: 0;
      background: none;
    }

    .dispatches li {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    .cv-line {
      flex-wrap: wrap;
      align-items: baseline;
    }

    .cv-leader {
      display: none;
    }

    .cv-date::before {
      content: '— ';
    }

    .area {
      grid-template-columns: 3.75rem minmax(0, 1fr);
      column-gap: 1rem;
      padding: 1.25rem 0;
    }

    .area-art {
      width: 3.75rem;
      height: 3.75rem;
    }

    .area-art svg {
      width: 3.1rem;
      height: 3.1rem;
    }

    /* On phones the tags become a simple list so long titles wrap cleanly */
    .works {
      display: block;
      margin-top: 0.7rem;
    }

    .works li {
      position: relative;
      padding: 0.2rem 0 0.2rem 1.1rem;
    }

    .works li::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0.95rem;
      width: 0.55rem;
      height: 2px;
      background: var(--gold);
    }

    .work {
      display: inline;
      padding: 0;
      border: 0;
      border-radius: 0;
      font-size: 0.95rem;
    }

    a.work .work-name {
      text-decoration: underline;
      text-decoration-color: rgba(var(--gold-rgb), 0.55);
      text-underline-offset: 0.2em;
    }

    a.jump::after {
      display: none;
    }

    .area-body {
      display: contents;
    }

    .area-art {
      grid-column: 1;
      grid-row: 1 / span 2;
    }

    .area-kicker {
      grid-column: 2;
      grid-row: 1;
      align-self: end;
    }

    .area-q {
      grid-column: 2;
      grid-row: 2;
      align-self: start;
      font-size: 1.12rem;
    }

    .area-text,
    .works {
      grid-column: 1 / -1;
    }

    .colophon {
      padding-top: 1.5rem;
      background: linear-gradient(var(--rule), var(--rule)) center 0 / calc(100% - 2 * var(--gutter)) 1px no-repeat;
    }
  }

  /* ===========================
     PRINT
  =========================== */
  @media print {
    .nav,
    .pub-filter,
    .pub-links,
    .notice,
    .theme-toggle {
      display: none !important;
    }

    :global(.js) .pub-list[data-filter='selected'] .pub,
    :global(.js) .pub-list[data-filter='selected'] .pub-year {
      display: grid !important;
    }

    :global(.js) .pub-list[data-filter='selected'] .pub-year {
      display: block !important;
    }

    .chapter-head {
      position: static;
    }

    .search-btn,
    .palette,
    .to-top,
    .now-caret {
      display: none !important;
    }
  }
</style>

<script>
  const root = document.documentElement;

  // Theme toggle (respects system preference until the visitor chooses)
  const darkQuery = matchMedia('(prefers-color-scheme: dark)');
  document.querySelector('.theme-toggle')?.addEventListener('click', () => {
    const current = root.dataset.theme ?? (darkQuery.matches ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      // Storage unavailable (private mode); the choice lasts for this page view.
    }
  });

  // Publication filter (Selected / All)
  const pubList = document.querySelector<HTMLElement>('.pub-list');
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('.pub-filter-btn');

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      pubList!.dataset.filter = button.dataset.filter;
      filterButtons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
    });
  });

  // BibTeX toggle and copy
  document.querySelectorAll<HTMLButtonElement>('.pub-bib-toggle').forEach((toggle) => {
    toggle.addEventListener('click', () => {
      const panel = document.getElementById(toggle.getAttribute('aria-controls')!)!;
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      panel.hidden = open;
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.pub-bib-copy').forEach((button) => {
    button.addEventListener('click', async () => {
      const pre = button.previousElementSibling!;
      try {
        await navigator.clipboard.writeText(pre.textContent ?? '');
        button.textContent = 'Copied';
      } catch {
        getSelection()?.selectAllChildren(pre);
        button.textContent = 'Selected';
      }
      setTimeout(() => (button.textContent = 'Copy'), 1600);
    });
  });

  // Show the name in the nav once the title-page name scrolls away
  const nav = document.querySelector<HTMLElement>('.nav')!;
  const titleName = document.querySelector('.title-name');
  if (titleName) {
    new IntersectionObserver(([entry]) => {
      nav.classList.toggle('is-condensed', !entry.isIntersecting);
    }, { rootMargin: '-48px 0px 0px 0px' }).observe(titleName);
  }

  // Active nav link
  const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('.nav-link[href^="#"]')];
  const sections = navLinks
    .map((link) => document.querySelector<HTMLElement>(link.getAttribute('href')!))
    .filter((section): section is HTMLElement => section !== null);

  let ticking = false;
  const update = () => {
    ticking = false;
    const max = document.documentElement.scrollHeight - innerHeight;

    const atBottom = scrollY >= max - 2;
    let current = '';
    if (atBottom) {
      current = sections[sections.length - 1]?.id ?? '';
    } else {
      sections.forEach((section) => {
        if (scrollY >= section.offsetTop - 160) current = section.id;
      });
    }
    navLinks.forEach((link) => {
      link.classList.toggle('active', link.getAttribute('href') === `#${current}`);
    });
  };

  addEventListener('scroll', () => {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(update);
    }
  }, { passive: true });
  addEventListener('resize', update);
  update();
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

  const toast = (message: string) => {
    document.querySelector('.toast')?.remove();
    const el = document.createElement('div');
    el.className = 'toast';
    el.setAttribute('role', 'status');
    el.textContent = message;
    document.body.append(el);
    setTimeout(() => el.remove(), 2100);
  };

  // "Currently" line: retype through research phrases
  const nowText = document.querySelector<HTMLElement>('.now-text');
  if (nowText && !reducedMotion) {
    const phrases: string[] = JSON.parse(nowText.dataset.phrases ?? '[]');
    (async () => {
      for (let i = 0; ; ) {
        await sleep(4200);
        const current = phrases[i];
        for (let n = current.length; n >= 0; n--) {
          nowText.textContent = current.slice(0, n);
          await sleep(16);
        }
        i = (i + 1) % phrases.length;
        const next = phrases[i];
        await sleep(250);
        for (let n = 1; n <= next.length; n++) {
          nowText.textContent = next.slice(0, n);
          await sleep(34 + Math.random() * 34);
        }
      }
    })();
  }

  // Count-up for the stats row
  if (!reducedMotion) {
    document.querySelectorAll<HTMLElement>('.stat-num[data-count]').forEach((el) => {
      const target = Number(el.dataset.count);
      el.textContent = '0';
      const start = performance.now() + 250;
      const tick = (now: number) => {
        const t = Math.max(0, Math.min((now - start) / 1100, 1));
        el.textContent = String(Math.round(target * (1 - Math.pow(1 - t, 3))));
        if (t < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    });
  }

  // Reveal chapters and draw highlighter marks as they scroll into view
  const revealTargets = document.querySelectorAll<HTMLElement>('.chapter, mark.hl');
  if ('IntersectionObserver' in window) {
    const revealer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add(entry.target.matches('mark') ? 'is-on' : 'is-in');
          revealer.unobserve(entry.target);
        });
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.01 },
    );
    revealTargets.forEach((el) => revealer.observe(el));
  } else {
    revealTargets.forEach((el) => el.classList.add('is-in', 'is-on'));
  }

  // Jump from a research "selected work" (or the palette) to its publication entry
  const flashPub = (key: string) => {
    const entry = document.getElementById(`pub-${key}`);
    if (!entry) return;
    if (entry.offsetParent === null) {
      document.querySelector<HTMLButtonElement>('.pub-filter-btn[data-filter="all"]')?.click();
    }
    entry.closest('.chapter')?.classList.add('is-in');
    entry.scrollIntoView({ behavior: reducedMotion ? 'auto' : 'smooth', block: 'center' });
    entry.classList.remove('is-flash');
    void entry.offsetWidth;
    entry.classList.add('is-flash');
    history.replaceState(null, '', `#pub-${key}`);
  };

  document.querySelectorAll<HTMLAnchorElement>('a.jump').forEach((link) => {
    link.addEventListener('click', (event) => {
      event.preventDefault();
      flashPub(link.dataset.jump!);
    });
  });

  if (location.hash.startsWith('#pub-')) {
    setTimeout(() => flashPub(location.hash.slice(5)), 300);
  }

  // Command palette (⌘K / Ctrl+K / "/")
  type PaletteItem = { group: string; label: string; meta?: string; haystack: string; run: () => void };
  const palette = document.querySelector<HTMLDialogElement>('.palette')!;
  const paletteInput = palette.querySelector<HTMLInputElement>('.palette-input')!;
  const paletteList = palette.querySelector<HTMLUListElement>('.palette-list')!;
  const papers: { key: string; title: string; venue: string; authors: string; bib: string }[] = JSON.parse(
    document.getElementById('palette-data')!.textContent!,
  );
  const scrollToEl = (el: Element) => {
    el.closest('.chapter')?.classList.add('is-in');
    el.scrollIntoView({ behavior: reducedMotion ? 'auto' : 'smooth', block: 'start' });
  };
  const copy = async (text: string, message: string) => {
    try {
      await navigator.clipboard.writeText(text);
      toast(message);
    } catch {
      toast('Copy failed — your browser blocked clipboard access');
    }
  };

  const sectionItems: PaletteItem[] = [
    ...[...document.querySelectorAll<HTMLElement>('section.chapter')].map((chapter) => ({
      group: 'Sections',
      label: chapter.querySelector('.chapter-title')!.textContent!.trim(),
      meta: `§ ${chapter.querySelector('.chapter-num')!.textContent!.trim()}`,
      run: () => scrollToEl(chapter),
    })),
    ...[...document.querySelectorAll<HTMLElement>('.cv-block')].map((block) => ({
      group: 'Sections',
      label: block.querySelector('.cv-label')!.textContent!.trim(),
      meta: '§ V',
      run: () => scrollToEl(block),
    })),
  ].map((item) => ({ ...item, haystack: item.label.toLowerCase() }));

  const paperItems: PaletteItem[] = papers.map((paper) => ({
    group: 'Papers',
    label: paper.title,
    meta: paper.venue,
    haystack: `${paper.title} ${paper.venue} ${paper.authors}`.toLowerCase(),
    run: () => flashPub(paper.key),
  }));

  const citeItems: PaletteItem[] = papers.map((paper) => ({
    group: 'Copy BibTeX',
    label: paper.title,
    meta: paper.venue,
    haystack: `${paper.title} ${paper.venue} ${paper.authors}`.toLowerCase(),
    run: () => copy(paper.bib, 'BibTeX copied'),
  }));

  const linkItems: PaletteItem[] = [...document.querySelectorAll<HTMLAnchorElement>('.title-links a')].map((link) => ({
    group: 'Links',
    label: link.textContent!.trim(),
    meta: link.href.startsWith('mailto:') ? 'mail' : new URL(link.href, location.href).hostname.replace(/^www\./, ''),
    haystack: `${link.textContent} ${link.href}`.toLowerCase(),
    run: () => window.open(link.href, link.href.startsWith('mailto:') ? '_self' : '_blank', 'noopener'),
  }));

  const actionItems: PaletteItem[] = [
    { label: 'Copy email address', meta: 'hbao@nd.edu', run: () => copy('hbao@nd.edu', 'Email address copied') },
    { label: 'Toggle dark mode', meta: 'theme', run: () => document.querySelector<HTMLButtonElement>('.theme-toggle')?.click() },
    { label: 'Show all publications', meta: 'filter', run: () => {
        document.querySelector<HTMLButtonElement>('.pub-filter-btn[data-filter="all"]')?.click();
        scrollToEl(document.getElementById('publications')!);
      } },
  ].map((item) => ({ ...item, group: 'Actions', haystack: `${item.label} ${item.meta}`.toLowerCase() }));

  let paletteItems: PaletteItem[] = [];
  let activeIndex = 0;

  const renderPalette = () => {
    const raw = paletteInput.value.trim().toLowerCase();
    const citeMatch = raw.match(/^(cite|bib|bibtex)\b\s*(.*)$/);
    const query = citeMatch ? citeMatch[2] : raw;
    const tokens = query.split(/\s+/).filter(Boolean);
    const hit = (item: PaletteItem) => tokens.every((token) => item.haystack.includes(token));

    if (citeMatch) {
      paletteItems = citeItems.filter(hit);
    } else if (!tokens.length) {
      paletteItems = [...sectionItems.slice(0, 5), ...actionItems, ...linkItems];
    } else {
      paletteItems = [
        ...sectionItems.filter(hit),
        ...paperItems.filter(hit).slice(0, 8),
        ...actionItems.filter(hit),
        ...linkItems.filter(hit),
      ];
    }
    activeIndex = Math.min(activeIndex, Math.max(paletteItems.length - 1, 0));

    if (!paletteItems.length) {
      paletteList.innerHTML = '<li class="pi-empty">No matches. Try a paper title, a venue like “icml”, or “cite”.</li>';
      return;
    }
    let lastGroup = '';
    paletteList.replaceChildren(
      ...paletteItems.flatMap((item, index) => {
        const nodes: HTMLElement[] = [];
        if (item.group !== lastGroup) {
          const header = document.createElement('li');
          header.className = 'pg';
          header.setAttribute('role', 'presentation');
          header.textContent = item.group;
          nodes.push(header);
          lastGroup = item.group;
        }
        const row = document.createElement('li');
        row.className = 'pi';
        row.id = `pi-${index}`;
        row.setAttribute('role', 'option');
        row.setAttribute('aria-selected', String(index === activeIndex));
        row.dataset.index = String(index);
        const label = document.createElement('span');
        label.className = 'pi-label';
        label.textContent = item.label;
        row.append(label);
        if (item.meta) {
          const meta = document.createElement('span');
          meta.className = 'pi-meta';
          meta.textContent = item.meta;
          row.append(meta);
        }
        nodes.push(row);
        return nodes;
      }),
    );
    paletteInput.setAttribute('aria-activedescendant', `pi-${activeIndex}`);
  };

  const moveActive = (delta: number) => {
    if (!paletteItems.length) return;
    activeIndex = (activeIndex + delta + paletteItems.length) % paletteItems.length;
    paletteList.querySelectorAll('.pi').forEach((row) => {
      row.setAttribute('aria-selected', String(Number((row as HTMLElement).dataset.index) === activeIndex));
    });
    paletteInput.setAttribute('aria-activedescendant', `pi-${activeIndex}`);
    paletteList.querySelector(`#pi-${activeIndex}`)?.scrollIntoView({ block: 'nearest' });
  };

  const runActive = (index = activeIndex) => {
    const item = paletteItems[index];
    if (!item) return;
    palette.close();
    item.run();
  };

  const openPalette = () => {
    if (palette.open) return;
    paletteInput.value = '';
    activeIndex = 0;
    renderPalette();
    palette.showModal();
    paletteInput.focus();
  };

  document.querySelector('.search-btn')?.addEventListener('click', openPalette);
  paletteInput.addEventListener('input', () => {
    activeIndex = 0;
    renderPalette();
  });
  paletteInput.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowDown') { event.preventDefault(); moveActive(1); }
    else if (event.key === 'ArrowUp') { event.preventDefault(); moveActive(-1); }
    else if (event.key === 'Enter') { event.preventDefault(); runActive(); }
  });
  paletteList.addEventListener('mousemove', (event) => {
    const row = (event.target as HTMLElement).closest<HTMLElement>('.pi');
    if (row && Number(row.dataset.index) !== activeIndex) moveActive(Number(row.dataset.index) - activeIndex);
  });
  paletteList.addEventListener('click', (event) => {
    const row = (event.target as HTMLElement).closest<HTMLElement>('.pi');
    if (row) runActive(Number(row.dataset.index));
  });
  palette.addEventListener('click', (event) => {
    if (event.target === palette) palette.close();
  });
  document.addEventListener('keydown', (event) => {
    const typing = (event.target as HTMLElement).closest('input, textarea, [contenteditable]');
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      palette.open ? palette.close() : openPalette();
    } else if (event.key === '/' && !typing && !palette.open) {
      event.preventDefault();
      openPalette();
    }
  });

  // Local time in Notre Dame, and how far it is from the visitor's clock
  const clock = document.querySelector<HTMLElement>('.clock');
  if (clock) {
    const tz = clock.dataset.tz!;
    const timeEl = clock.querySelector('.clock-time')!;
    const diffEl = document.querySelector('.clock-diff')!;
    const fmt = new Intl.DateTimeFormat('en-US', { timeZone: tz, hour: 'numeric', minute: '2-digit' });
    const hourFmt = new Intl.DateTimeFormat('en-US', { timeZone: tz, hour: 'numeric', hourCycle: 'h23' });
    const renderClock = () => {
      const now = new Date();
      timeEl.textContent = fmt.format(now);
      const hour = Number(hourFmt.format(now));
      clock.classList.toggle('is-night', hour < 7 || hour >= 22);
      const there = new Date(now.toLocaleString('en-US', { timeZone: tz }));
      const here = new Date(now.toLocaleString('en-US'));
      const diff = Math.round(((there.getTime() - here.getTime()) / 36e5) * 2) / 2;
      diffEl.textContent =
        diff === 0 ? 'same time as you' : `${Math.abs(diff)}h ${diff < 0 ? 'behind' : 'ahead of'} you`;
    };
    renderClock();
    setInterval(renderClock, 30_000);
  }

  // Sidenote <-> reference hover linking
  document.querySelectorAll<HTMLElement>('.sn-ref').forEach((ref) => {
    const note = ref.nextElementSibling as HTMLElement | null;
    if (!note?.classList.contains('sidenote')) return;
    const link = (on: boolean) => {
      ref.classList.toggle('is-linked', on);
      note.classList.toggle('is-linked', on);
    };
    const anchor = ref.previousElementSibling as HTMLElement | null;
    [anchor, note].forEach((el) => {
      el?.addEventListener('mouseenter', () => link(true));
      el?.addEventListener('mouseleave', () => link(false));
    });
  });

  // Back-to-top ring and per-chapter reading progress
  const toTop = document.querySelector<HTMLElement>('.to-top');
  const progressChapters = [...document.querySelectorAll<HTMLElement>('section.chapter')];
  let progressQueued = false;
  const updateProgress = () => {
    progressQueued = false;
    const max = document.documentElement.scrollHeight - innerHeight;
    const page = max > 0 ? Math.min(scrollY / max, 1) : 0;
    toTop?.style.setProperty('--page', page.toFixed(3));
    toTop?.classList.toggle('is-shown', scrollY > innerHeight * 0.6);
    const line = scrollY + innerHeight * 0.4;
    progressChapters.forEach((chapter) => {
      const top = chapter.offsetTop;
      const read = Math.max(0, Math.min((line - top) / Math.max(chapter.offsetHeight, 1), 1));
      chapter.style.setProperty('--read', read.toFixed(3));
    });
  };
  addEventListener(
    'scroll',
    () => {
      if (!progressQueued) {
        progressQueued = true;
        requestAnimationFrame(updateProgress);
      }
    },
    { passive: true },
  );
  addEventListener('resize', updateProgress);
  updateProgress();
  toTop?.addEventListener('click', (event) => {
    event.preventDefault();
    scrollTo({ top: 0, behavior: reducedMotion ? 'auto' : 'smooth' });
    history.replaceState(null, '', location.pathname);
  });

  // A hello for anyone who opens the developer console
  console.log(
    '%cHi there 👋%c\nThanks for peeking under the hood. Press ⌘K (or /) to search the page.\nSource: https://github.com/wad3birch/wad3birch.github.io',
    'font: 600 15px Georgia, serif; color: #0c2340',
    'font: 13px Georgia, serif; color: #6b6b6b',
  );

  // Show the right shortcut hint on non-Apple keyboards
  if (!/Mac|iPhone|iPad/.test(navigator.platform)) {
    document.querySelectorAll('.search-kbd').forEach((kbd) => {
      if (kbd.textContent === '⌘K') kbd.textContent = 'Ctrl K';
    });
  }
</script>
