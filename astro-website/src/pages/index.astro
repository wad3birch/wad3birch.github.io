    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  :global(html:not(.js)) .nav-brand,
  .nav.is-condensed .nav-brand {
    opacity: 1;
    transform: none;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    min-width: 0;
    margin-left: auto;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .nav-links::-webkit-scrollbar {
    display: none;
  }

  .nav-link {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    padding: 0.2rem 0;
    color: var(--ink-2);
    font-size: 0.7rem;
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    white-space: nowrap;
  }

  .nav-num {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
    color: var(--gold-text);
  }

  .nav-label-short {
    display: none;
  }

  .nav-link:hover {
    color: var(--ink);
  }

  .nav-link.active {
    color: var(--ink);
    border-bottom-color: var(--gold);
  }

  .nav-link--pdf {
    padding: 0.15rem 0.55rem;
    border: 1px solid var(--rule);
    border-radius: 2px;
  }

  .nav-link--pdf:hover {
    border-color: var(--gold);
  }

  .theme-toggle {
    flex: 0 0 auto;
    display: none;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--rule);
    border-radius: 50%;
    background: transparent;
    color: var(--ink-2);
    cursor: pointer;
  }

  :global(.js) .theme-toggle {
    display: grid;
  }

  .theme-toggle:hover {
    border-color: var(--gold);
    color: var(--gold-text);
  }

  .theme-toggle svg {
    grid-area: 1 / 1;
  }

  .icon-sun {
    display: none;
  }

  :global(:root[data-theme='dark']) .icon-sun {
    display: block;
  }

  :global(:root[data-theme='dark']) .icon-moon {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .icon-sun {
      display: block;
    }

    :global(:root:not([data-theme='light'])) .icon-moon {
      display: none;
    }
  }

  /* ===========================
     TITLE PAGE
  =========================== */
  .title-page {
    padding-top: clamp(2.25rem, 5vw, 3.5rem);
  }

  .kicker {
    color: var(--gold-text);
    font-size: 0.72rem;
    font-weight: 600;
  }

  .title-name {
    margin-top: 0.35rem;
    font-size: clamp(2.4rem, 5.5vw, 3.2rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--accent);
  }

  .title-rule {
    margin-top: 1.1rem;
    border-top: 1px solid var(--rule);
  }

  .title-grid {
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr) var(--margin);
    column-gap: var(--gap);
    padding-top: 1.75rem;
  }

  .title-meta {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    font-size: 0.86rem;
    line-height: 1.35;
  }

  .title-meta dt {
    color: var(--ink-3);
    font-size: 0.62rem;
    font-weight: 600;
  }

  .title-meta dd {
    margin-top: 0.1rem;
    color: var(--ink-2);
  }

  .deck {
    max-width: 36rem;
    font-size: 1.18rem;
    line-height: 1.6;
    color: var(--ink-2);
  }

  .title-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0;
    margin-top: 1rem;
    font-size: 0.95rem;
  }

  .title-links a:not(:last-child)::after {
    content: '/';
    display: inline-block;
    margin: 0 0.7rem;
    color: var(--rule);
  }

  .title-figure {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .portrait {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 2px;
  }

  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 24%;
  }

  .title-figure figcaption {
    line-height: 1;
  }

  .seals {
    display: flex;
    gap: 0.5rem;
  }

  .seals a {
    display: block;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    opacity: 0.85;
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  .seals a:hover {
    opacity: 1;
    transform: translateY(-1px);
  }

  .seals img {
    width: 100%;
    height: 100%;
  }

  /* ===========================
     NOTICE
  =========================== */
  .notice {
    display: grid;
    margin-top: 1.75rem;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.4rem 1.25rem;
    align-items: baseline;
    padding: 0.7rem 0.9rem;
    border-left: 2px solid var(--gold);
    background: rgba(var(--gold-rgb), 0.07);
  }

  .notice-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--gold-text);
    font-size: 0.68rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .notice-dot {
    position: relative;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--live);
  }

  .notice-text {
    color: var(--ink-2);
    line-height: 1.55;
  }

  /* ===========================
     CHAPTERS (shared spacing)
  =========================== */
  /* Rule drawn as a background so it stops at the content edge, not the gutter */
  :global(.chapter) {
    margin-top: 3rem;
    padding-top: 2.25rem;
    background: linear-gradient(var(--rule), var(--rule)) center top / calc(100% - 2 * var(--gutter)) 1px no-repeat;
  }

  /* ===========================
     I. ABOUT
  =========================== */
  .prose {
    counter-reset: sidenote;
    max-width: calc(100% - var(--margin) - var(--gap));
  }

  .prose p {
    color: var(--ink-2);
  }

  .prose p + p {
    margin-top: 0.85rem;
  }

  .prose strong {
    color: var(--ink);
    font-weight: 600;
  }

  .sn-ref::after {
    counter-increment: sidenote;
    content: counter(sidenote);
    position: relative;
    top: -0.5em;
    margin-left: 0.08em;
    font-size: 0.7em;
    color: var(--gold-text);
    font-variant-numeric: lining-nums;
  }

  .sidenote {
    float: right;
    clear: right;
    width: var(--margin);
    margin-right: calc(-1 * (var(--margin) + var(--gap)));
    margin-top: 0.2rem;
    margin-bottom: 0.75rem;
    color: var(--ink-3);
    font-size: 0.82rem;
    line-height: 1.45;
  }

  .sidenote::before {
    content: counter(sidenote) '. ';
    color: var(--gold-text);
    font-variant-numeric: lining-nums;
  }

  /* ===========================
     II. NEWS
  =========================== */
  .dispatches {
    list-style: none;
    max-width: 46rem;
  }

  .dispatches li {
    display: grid;
