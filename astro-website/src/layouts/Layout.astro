---
import { getImage } from 'astro:assets';
import portrait from '../assets/self.jpeg';

interface Props {
  title: string;
}

const { title } = Astro.props;
const description = 'Han Bao is a first-year Ph.D. student at the University of Notre Dame studying reliable and aligned LLM agents, failure diagnosis, and trustworthy AI evaluation.';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImage = await getImage({ src: portrait, width: 600, format: 'jpeg' });
const ogImageUrl = new URL(ogImage.src, Astro.site);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Han Bao',
  url: canonicalUrl.href,
  image: ogImageUrl.href,
  email: 'mailto:hbao@nd.edu',
  jobTitle: 'Ph.D. Student',
  affiliation: {
    '@type': 'CollegeOrUniversity',
    name: 'University of Notre Dame',
    url: 'https://www.nd.edu/',
  },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Sichuan University',
    url: 'https://www.scu.edu.cn/',
  },
  knowsAbout: ['Trustworthy AI', 'LLM Agents', 'AI Alignment', 'Foundation Model Evaluation'],
  sameAs: [
    'https://scholar.google.com/citations?user=X8gcICcAAAAJ',
    'https://github.com/wad3birch',
    'https://www.linkedin.com/in/han-bao-59796b379/',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="author" content="Han Bao" />
    <meta name="keywords" content="Han Bao, trustworthy AI, LLM agents, AI alignment, foundation model evaluation, University of Notre Dame" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Research on reliable and aligned LLM agents, failure diagnosis, and trustworthy AI evaluation." />
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={ogImageUrl.href} />
    <meta property="og:image:alt" content="Portrait of Han Bao" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content="Research on reliable and aligned LLM agents, failure diagnosis, and trustworthy AI evaluation." />
    <meta name="twitter:image" content={ogImageUrl.href} />
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="apple-touch-icon" href="/favicon.svg?v=2" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap" rel="stylesheet">
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>document.documentElement.classList.add('js');</script>
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    /* Notre Dame Colors */
    --nd-blue: #0c2340;
    --nd-blue-rgb: 12, 35, 64;
    --nd-gold: #c99700;
    --nd-gold-rgb: 201, 151, 0;

    /* Neutrals */
    --gray-50: #f9fafb;
    --gray-100: #f3f4f6;
    --gray-200: #e5e7eb;
    --gray-300: #d1d5db;
    --gray-400: #9ca3af;
    --gray-500: #6b7280;
    --gray-600: #4b5563;
    --gray-700: #374151;

    /* Semantic */
    --bg-primary: #ffffff;
    --text-primary: #111827;
    --text-secondary: #374151;
    --text-muted: #6b7280;
    --border: #e5e7eb;
    --link: #1f4f96;

    /* Typography */
    --font-serif: 'Source Serif 4', Georgia, 'Times New Roman', serif;
    --font-sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
    --font-mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;

    /* Spacing */
    --space-xs: 0.25rem;
    --space-sm: 0.5rem;
    --space-md: 1rem;
    --space-lg: 1.5rem;
    --space-xl: 1.75rem;
    --space-2xl: 2.25rem;

    /* Container */
    --container-max: 800px;
    --container-padding: clamp(1.25rem, 3vw, 2rem);
  }

  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    font-size: 16px;
  }

  body {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--text-primary);
    background-color: var(--bg-primary);
  }

  ::-webkit-scrollbar {
    width: 5px;
  }
  ::-webkit-scrollbar-track {
    background: var(--gray-50);
  }
  ::-webkit-scrollbar-thumb {
    background: var(--gray-300);
    border-radius: 3px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: var(--gray-400);
  }

  ::selection {
    background-color: rgba(var(--nd-gold-rgb), 0.2);
    color: var(--nd-blue);
  }

  :focus-visible {
    outline: 2px solid var(--nd-gold);
    outline-offset: 2px;
    border-radius: 2px;
  }

  a {
    color: var(--link);
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
    text-decoration-color: var(--nd-gold);
    text-underline-offset: 3px;
  }

  h1, h2, h3, h4, h5, h6 {
    line-height: 1.25;
    color: var(--text-primary);
  }

  img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  pre,
  code {
    font-family: var(--font-mono);
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>
