---
import { getImage } from 'astro:assets';
import portrait from '../assets/self.jpeg';

interface Props {
  title: string;
}

const { title } = Astro.props;
const description = 'Han Bao is a first-year Ph.D. student at the University of Notre Dame studying reliable and aligned LLM agents, failure diagnosis, and trustworthy AI evaluation.';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImage = await getImage({ src: portrait, width: 600, format: 'jpeg' });
const ogImageUrl = new URL(ogImage.src, Astro.site);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Han Bao',
  url: canonicalUrl.href,
  image: ogImageUrl.href,
  email: 'mailto:hbao@nd.edu',
  jobTitle: 'Ph.D. Student',
  affiliation: {
    '@type': 'CollegeOrUniversity',
    name: 'University of Notre Dame',
    url: 'https://www.nd.edu/',
  },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Sichuan University',
    url: 'https://www.scu.edu.cn/',
  },
  knowsAbout: ['Trustworthy AI', 'LLM Agents', 'AI Alignment', 'Foundation Model Evaluation'],
  sameAs: [
    'https://scholar.google.com/citations?user=X8gcICcAAAAJ',
    'https://github.com/wad3birch',
    'https://www.linkedin.com/in/han-bao-59796b379/',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="author" content="Han Bao" />
    <meta name="keywords" content="Han Bao, trustworthy AI, LLM agents, AI alignment, foundation model evaluation, University of Notre Dame" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#12161d" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Research on reliable and aligned LLM agents, failure diagnosis, and trustworthy AI evaluation." />
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={ogImageUrl.href} />
    <meta property="og:image:alt" content="Portrait of Han Bao" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content="Research on reliable and aligned LLM agents, failure diagnosis, and trustworthy AI evaluation." />
    <meta name="twitter:image" content={ogImageUrl.href} />
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="apple-touch-icon" href="/favicon.svg?v=2" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400;1,8..60,600&display=swap" rel="stylesheet">
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        try {
          var theme = localStorage.getItem('theme');
          if (theme === 'dark' || theme === 'light') root.dataset.theme = theme;
        } catch (e) {}
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  /* ===========================
     TOKENS
  =========================== */
  :root {
    color-scheme: light;

    /* Paper and ink */
    --paper: #ffffff;
    --paper-2: #f7f6f3;
    --ink: #1a1a1a;
    --ink-2: #3d3d3d;
    --ink-3: #6b6b6b;
    --rule: #e4e4e4;
    --rule-soft: #f0f0f0;

    /* Notre Dame accents */
    --accent: #0c2340;
    --gold: #c99700;
    --gold-rgb: 201, 151, 0;
    --gold-text: #8a6500;
    --link: #1f4f96;
    --live: #2e9d5b;

    /* Research direction colors */
    --area-0: #2a5ea8;
    --area-1: #a4740a;
    --area-2: #2f7564;

    /* Typography */
    --font-display: 'Source Serif 4', Georgia, 'Times New Roman', serif;
    --font-serif: 'Source Serif 4', Georgia, 'Times New Roman', serif;
    --font-mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;

    /* Grid: rail | main | margin */
    --rail: 8rem;
    --margin: 12rem;
    --gap: 2.5rem;
    --gutter: clamp(1.25rem, 4vw, 2.5rem);
    --page-max: 68rem;
  }

  :root[data-theme='dark'] {
    color-scheme: dark;
    --paper: #12161d;
    --paper-2: #1a2029;
    --ink: #ece7db;
    --ink-2: #c8c2b4;
    --ink-3: #969083;
    --rule: #343b47;
    --rule-soft: #262c36;
    --accent: #f1e7cd;
    --gold: #d6a72b;
    --gold-rgb: 214, 167, 43;
    --gold-text: #e2b84c;
    --link: #a3c1f2;
    --live: #4cc27e;
    --area-0: #86aeec;
    --area-1: #e0b54a;
    --area-2: #72c3ab;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) {
      color-scheme: dark;
      --paper: #12161d;
      --paper-2: #1a2029;
      --ink: #ece7db;
      --ink-2: #c8c2b4;
      --ink-3: #969083;
      --rule: #343b47;
      --rule-soft: #262c36;
      --accent: #f1e7cd;
      --gold: #d6a72b;
      --gold-rgb: 214, 167, 43;
      --gold-text: #e2b84c;
      --link: #a3c1f2;
      --live: #4cc27e;
    --area-0: #86aeec;
    --area-1: #e0b54a;
    --area-2: #72c3ab;
    }
  }

  @media (max-width: 1099px) {
    :root {
      --rail: 6rem;
      --gap: 2rem;
      --page-max: 54rem;
    }
  }

  /* ===========================
     BASE
  =========================== */
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    font-size: 16px;
  }

  body {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    line-height: 1.65;
    font-variant-numeric: oldstyle-nums proportional-nums;
    color: var(--ink);
    background-color: var(--paper);
    transition: background-color 0.25s ease, color 0.25s ease;
  }

  ::selection {
    background-color: rgba(var(--gold-rgb), 0.28);
    color: var(--ink);
  }

  :focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
    border-radius: 2px;
  }

  a {
    color: inherit;
    text-decoration-line: underline;
    text-decoration-color: rgba(var(--gold-rgb), 0.55);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    transition: color 0.15s ease, text-decoration-color 0.15s ease;
  }

  a:hover {
    color: var(--gold-text);
    text-decoration-color: currentColor;
  }

  h1, h2, h3, h4, h5, h6 {
    line-height: 1.2;
    font-weight: 600;
    color: var(--ink);
  }

  img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  pre,
  code {
    font-family: var(--font-mono);
  }

  button {
    font: inherit;
    color: inherit;
  }

  /* ===========================
     PAGE GRID
  =========================== */
  .wrap {
    max-width: var(--page-max);
    margin: 0 auto;
    padding-left: var(--gutter);
    padding-right: var(--gutter);
  }

  .chapter {
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr);
    column-gap: var(--gap);
    scroll-margin-top: 3.25rem;
  }

  @media (max-width: 759px) {
    .chapter {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    *, *::before, *::after {
      transition: none !important;
      animation: none !important;
    }
  }
</style>
